# Markdown Workflow External Dependencies
# Install with: brew bundle

# Core dependencies
brew "node"              # Node.js runtime (v20+)
brew "pnpm"              # Package manager

# Document processing
brew "pandoc"            # Document conversion (DOCX, HTML, PDF, PPTX)

# Diagram processors
brew "graphviz"          # Graphviz processor (dot, neato, fdp, circo, twopi)
brew "plantuml"          # PlantUML processor (UML diagrams)

# Web scraping (optional)
brew "wget"              # Preferred web scraper
